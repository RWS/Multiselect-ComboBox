<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- DropDown Button -->
    <SolidColorBrush x:Key="MultiSelectComboBox.DropDown.Button.Background" Color="Transparent"/>
    <SolidColorBrush x:Key="MultiSelectComboBox.DropDown.Button.Border" Color="#404040"/>
    <SolidColorBrush x:Key="MultiSelectComboBox.DropDown.Button.Disabled.Background" Color="#313131"/>
    <SolidColorBrush x:Key="MultiSelectComboBox.DropDown.Button.Disabled.Border" Color="#404040"/>
    <SolidColorBrush x:Key="MultiSelectComboBox.DropDown.Button.Disabled.Foreground" Color="#9D9D9D"/>
    <SolidColorBrush x:Key="MultiSelectComboBox.DropDown.Button.MouseOver.Background" Color="#3D3D3D"/>
    <SolidColorBrush x:Key="MultiSelectComboBox.DropDown.Button.MouseOver.Border" Color="#0078D4"/>
    <SolidColorBrush x:Key="MultiSelectComboBox.DropDown.Button.Pressed.Background" Color="#3D3D3D"/>
    <SolidColorBrush x:Key="MultiSelectComboBox.DropDown.Button.Pressed.Border" Color="#0078D4"/>

    <!-- DropDown ListBox Group Header -->
    <SolidColorBrush x:Key="MultiSelectComboBox.DropDown.ListBox.GroupHeader.Background" Color="#2B2B2B"/>
    <SolidColorBrush x:Key="MultiSelectComboBox.DropDown.ListBox.GroupHeader.Foreground" Color="#FFFFFF"/>

    <!-- DropDown ListBox Items -->
    <SolidColorBrush x:Key="MultiSelectComboBox.DropDown.ListBoxItem.SelectedOrder.Foreground" Color="#66C9FF"/>
    <SolidColorBrush x:Key="MultiSelectComboBox.DropDown.ListBoxItem.Selector.Background" Color="#3D3D3D"/>
    <SolidColorBrush x:Key="MultiSelectComboBox.DropDown.ListBoxItem.Selector.Border" Color="#4A4A4A"/>
    <SolidColorBrush x:Key="MultiSelectComboBox.DropDown.ListBoxItem.Selected.Background" Color="#4A4A4A"/>
    <SolidColorBrush x:Key="MultiSelectComboBox.DropDown.ListBoxItem.Selected.Border" Color="#0078D4"/>
    <SolidColorBrush x:Key="MultiSelectComboBox.DropDown.ListBoxItem.Selected.Foreground" Color="#FFFFFF"/>

    <!-- Selected Items Panel -->
    <SolidColorBrush x:Key="MultiSelectComboBox.SelectedItem.Border" Color="#404040"/>
    <SolidColorBrush x:Key="MultiSelectComboBox.SelectedItem.Button.Foreground" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="MultiSelectComboBox.SelectedItem.Button.Hover.Background" Color="#3D3D3D"/>
    <SolidColorBrush x:Key="MultiSelectComboBox.SelectedItem.Button.Light.Foreground" Color="#9D9D9D"/>
    <SolidColorBrush x:Key="MultiSelectComboBox.SelectedItemsPanel.Border" Color="#404040"/>
    <SolidColorBrush x:Key="MultiSelectComboBox.SelectedItemsPanel.Background" Color="#313131"/>

    <!-- Text -->
    <FontFamily x:Key="MultiSelectComboBox.Text.FontFamily">Segoe UI</FontFamily>
    <SolidColorBrush x:Key="MultiSelectComboBox.Text.Disabled.Foreground" Color="#6E6E6E"/>
    <SolidColorBrush x:Key="MultiSelectComboBox.Text.Foreground" Color="#FFFFFF"/>

    <!-- No Results -->
    <SolidColorBrush x:Key="MultiSelectComboBox.NoResults.Border" Color="#404040"/>

    <!-- AutoComplete TextBox -->
    <Thickness x:Key="MultiSelectComboBox.AutoComplete.TextBox.Margin">-2,0,0,0</Thickness>
    <Thickness x:Key="MultiSelectComboBox.AutoComplete.TextBox.Padding">-3,1,0,1</Thickness>

</ResourceDictionary>